# Required: your Anthropic API key (console.anthropic.com → API keys)
ANTHROPIC_API_KEY=

# Optional: Vercel Blob read-write token. Without it, generated guides are saved to data/generated/ locally.
# On Vercel this is added automatically when you connect a Blob store to the project.
BLOB_READ_WRITE_TOKEN=

# Optional overrides
# ANTHROPIC_MODEL=claude-opus-5-5
# AGENT_EFFORT=medium
# GENERATE_LIMIT_PER_HOUR=10
