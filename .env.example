# Research provider: anthropic | gemini | groq.
# Leave unset to use Groq when GROQ_API_KEY is set, otherwise Anthropic.
# RESEARCH_PROVIDER=groq

# Needed when RESEARCH_PROVIDER=anthropic (console.anthropic.com → API keys)
ANTHROPIC_API_KEY=

# Needed for Groq (console.groq.com → API Keys); setting it makes Groq the default
GROQ_API_KEY=

# Needed when RESEARCH_PROVIDER=gemini
GEMINI_API_KEY=     # aistudio.google.com → Get API key

# Needed for Groq and Gemini: web search and page reading (app.tavily.com, free plan: 1,000 credits/month)
TAVILY_API_KEY=

# Vercel Blob storage for generated guides. Required on Vercel; without it, local runs use data/generated/.
# Connecting a Blob store on Vercel adds one of these automatically:
# BLOB_STORE_ID=                    # OIDC: the SDK signs in with the deployment's VERCEL_OIDC_TOKEN, no secret needed
BLOB_READ_WRITE_TOKEN=               # or a read-write token (some stores name it BLOB_DATABASE_READ_WRITE_TOKEN)
# Must match how the Blob store was created: public (default) or private. A mismatch makes every save fail.
# BLOB_ACCESS=public

# Optional overrides
# RESEARCH_MODEL=claude-opus-5-5   # Anthropic model; default is claude-sonnet-5-5
# GEMINI_MODEL=gemini-3.7-flash     # Gemini model; this is the default (has free-tier quota)
# GROQ_MODEL=openai/gpt-oss-120b    # Groq model; this is the default
# GROQ_REASONING_EFFORT=low         # low | medium | high (higher uses more of Groq's per-minute token limit)
# GROQ_PAGE_CHARS=8000              # page text sent to Groq per guide (free tier: 8,000 tokens per request/minute)
# GROQ_MAX_TOKENS=4000              # longest answer Groq may write
# AGENT_EFFORT=medium
# GENERATE_LIMIT_PER_HOUR=10
